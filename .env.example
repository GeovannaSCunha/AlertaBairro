# Copie para .env e preencha. O arquivo .env NUNCA deve ir para o Git (já está no .gitignore).

# --- Databricks (SQL Statement Execution API 2.0) ---------------------------------------------
# Sem estas três variáveis, a API usa o snapshot validado em 13/11/2026 e a tela mostra "Snapshot".
# Host e Warehouse ID: SQL Warehouses > (seu warehouse) > Connection details.
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
# Token pessoal (Settings > Developer > Access tokens) ou token OAuth de service principal.
DATABRICKS_TOKEN=
DATABRICKS_CATALOG=workspace
DATABRICKS_SCHEMA=alertabairro
CACHE_TTL_S=600

# --- Moderação -----------------------------------------------------------------------------------
# Mínimo de 16 caracteres. Gere um com:  python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_TOKEN=

# --- Assistente com LLM local (opcional) ---------------------------------------------------------
# Sem estas variáveis o assistente responde no modo "regras" (sem modelo de linguagem).
# Exemplo com Ollama no seu computador:  ollama pull qwen2.5:3b-instruct
# LLM_BASE_URL=http://host.docker.internal:11434/v1   (dentro do Docker)
# LLM_BASE_URL=http://localhost:11434/v1              (rodando a API fora do Docker)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# --- Privacidade e limites -----------------------------------------------------------------------
RETENCAO_FOTOS_DIAS=90
LIMITE_RELATOS_POR_HORA=5
LIMITE_ASSISTENTE_POR_MINUTO=20

# --- Grafana (perfil observabilidade) ------------------------------------------------------------
GRAFANA_SENHA=
